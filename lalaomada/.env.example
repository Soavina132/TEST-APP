# Supabase — configurer dans Lovable Cloud > Project Settings > Environment Variables
# Toutes ces variables sont obligatoires pour que l'app fonctionne
SUPABASE_PROJECT_ID="votre-project-id"
SUPABASE_URL="https://votre-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="votre-anon-key"
SUPABASE_SERVICE_ROLE_KEY="votre-service-role-key"

# Variables Vite (injectees dans le bundle front-end au moment du build)
VITE_SUPABASE_URL="https://votre-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="votre-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="votre-anon-key"

# Lovable AI Gateway — pour l'assistant IA (optionnel)
LOVABLE_API_KEY="votre-lovable-api-key"
